{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Deliberately self-contained (no `extends` reaching outside the package):
  // the Node-side config for main + preload + their tests. Shares its base
  // options with tsconfig.web.json — keep the two in sync.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "test/main/**/*",
    "test/preload/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
