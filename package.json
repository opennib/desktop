{
  "name": "@opennib/desktop",
  "version": "0.1.0",
  "description": "opennib desktop app — Electron shell that hosts @opennib/core's dictation pipeline on macOS, Windows, and Linux.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:native": "bash scripts/build-native.sh",
    "build:tray-icon": "node scripts/build-tray-icon.mjs",
    "dist": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build:native && npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@opennib/core": "^0.1.2",
    "@qvac/sdk": "0.16.0",
    "bare-abort-controller": "^1.0.0",
    "bare-buffer": "^3.4.2",
    "bare-crypto": "^1.13.4",
    "bare-dns": "^2.1.4",
    "bare-fetch": "^2.5.1",
    "bare-fs": "^4.5.2",
    "bare-http1": "^4.1.6",
    "bare-https": "^2.1.3",
    "bare-link": "^3.2.1",
    "bare-net": "^2.2.0",
    "bare-os": "^3.6.2",
    "bare-path": "^3.0.0",
    "bare-process": "^4.2.2",
    "bare-rpc": "^1.0.0",
    "bare-runtime": "^1.31.0",
    "bare-stream": "^2.7.0",
    "bare-subprocess": "^5.2.3",
    "bare-zlib": "^1.3.1",
    "compact-encoding": "^2.19.0",
    "corestore": "^7.4.5",
    "hyperdb": "^4.19.0",
    "hyperdrive": "^13.0.1",
    "hyperswarm": "^4.12.1",
    "llm-splitter": "~0.2.0",
    "node-global-key-listener": "^0.3.0",
    "tar-stream": "^3.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bare": "^1.16.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.22",
    "shell-quote": "^1.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opennib/desktop.git"
  },
  "homepage": "https://github.com/opennib/desktop",
  "bugs": {
    "url": "https://github.com/opennib/desktop/issues"
  }
}
